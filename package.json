{
  "name": "ds-balance",
  "version": "0.2.4",
  "description": "DeepSeek API balance + per-call cost tracker — a dsh plugin (cordis host half + sidebar client half)",
  "license": "MIT",
  "author": "storyOuO",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node test/ds-balance.test.mjs && node test/bundle-patch.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "balance",
    "cost",
    "pricing",
    "cordis",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
